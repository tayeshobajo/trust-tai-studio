# Trust Tai Studio — environment variable names only. Never commit real values.

# Client-safe (exposed to the browser bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Set these as server secrets, never with a VITE_ prefix.
STUDIO_SUPABASE_URL=
STUDIO_SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
RUNWAY_API_KEY=

# Server-only production engine configuration (model names only, no secrets).
# Safe defaults if unset: gen4_image / gen4_turbo / veo3
# Video duration is clamped server-side to the provider contract (5s or 10s).
RUNWAY_IMAGE_MODEL=
RUNWAY_VIDEO_MODEL=
RUNWAY_TEXT_VIDEO_MODEL=

# Background Runway task sweep (server-only).
# Shared secret required by POST /api/public/production-sweep, sent as the
# `x-studio-cron-secret` header by the scheduler (pg_cron or similar).
# Without it the endpoint returns 503 and no background polling happens.
STUDIO_CRON_SECRET=
